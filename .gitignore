# SQLite databases — runtime state, recreated on first run
*.db
*.sqlite
*.sqlite3

# Cached ticker directory (NSE stocks + AMFI mutual funds) — refetched automatically
cache/

# Saved bank-email attachments (PDF/CSV/Excel statements) from Mail Scan —
# real personal financial documents, never committed
mail_attachments/

# Holding documents (contract notes, certificates, deposit receipts, etc.)
# attached to a deposit, metal, investment, or retirement account — real
# personal financial documents, never committed
deposit_attachments/
metal_attachments/
investment_attachments/
retirement_attachments/
bank_account_attachments/
tax_attachments/

# Flask session signing key — generated on first run, must not be shared/committed
.flask_secret_key

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# Virtual environments
.venv/
venv/
venv-*/
env/
.env

# Jupyter
.ipynb_checkpoints/

# PyInstaller build output — rebuilt by .github/workflows/build-apps.yml
build/
dist/
*.spec

# Android/Gradle build output and machine-specific config — rebuilt by
# .github/workflows/build-android.yml. (build/ above already covers
# android/app/build/ and android/build/ since it matches at any depth.)
android/.gradle/
android/local.properties
android/*.iml
android/app/*.iml

# iOS/Xcode build output — rebuilt by .github/workflows/build-ios.yml.
# (build/ above already covers ios/build/ since it matches at any depth.)
ios/.briefcase/

# Editor / OS
.DS_Store
.idea/
.vscode/
*.swp

# Backups and safety copies of real data (made by Backup / Restore / Reset) - never committed
fd-manager-before-reset-*/
fd-manager-before-restore-*/
fd-manager-full-backup-*.zip
.restore-upload-*
